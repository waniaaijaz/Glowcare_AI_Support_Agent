# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glowcare
DB_USER=postgres
DB_PASSWORD=change-me

# LLM provider: gemini (free tier), openai, or ollama (runs locally)
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:1.5b

# Reply in the customer's language. Adds one small LLM call per non-knowledge
# reply; set to off to skip it (replies stay in English).
MATCH_CUSTOMER_LANGUAGE=on

# Restate non-English questions in English before searching the documents. Keep on.
TRANSLATE_FOR_SEARCH=on

# Password for the admin dashboard. Leave empty only on your own computer,
# because the dashboard shows customer chats.
DASHBOARD_PASSWORD=

# Optional: escalation emails from the demo server (whatsapp_demo.py).
# Use a Gmail app password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
ALERT_TO=
